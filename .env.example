# =============================================================================
# Cuisine · variables de entorno
# Copia este archivo como ".env" para probar en tu computadora.
# En Render estas variables se agregan en la sección "Environment" del servicio web.
# =============================================================================

# Puerto del servidor local (Render pone el suyo solo)
PORT=3000

# Base de datos
#  - Vacío: se usa SQLite en el archivo recetas.db (lo más rápido para probar).
#  - Con valor: PostgreSQL. En Render pega la "Internal Database URL" de tu base.
#  - PostgreSQL en tu computadora, por ejemplo:
#    DATABASE_URL=postgresql://postgres:tu_clave@localhost:5432/cuisine
DATABASE_URL=

# SSL de PostgreSQL: se activa solo en servidores remotos (con rejectUnauthorized: false).
# Pon "false" si tu servidor no lo usa.
# DATABASE_SSL=false

# Dirección pública del sitio (para compartir y para el mapa del sitio).
# En Render se detecta sola con RENDER_EXTERNAL_URL.
# URL_PUBLICA=https://tu-sitio.onrender.com

# Recetas de ejemplo: se cargan solas si la tabla está vacía. Pon "false" para no cargarlas.
# CARGAR_EJEMPLOS=true

# Nombre del archivo de SQLite (opcional)
# SQLITE_ARCHIVO=recetas.db
